{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      ".write": false
    },

    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      ".indexOn": ["email", "mobile"],
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['name', 'email']) || newData.hasChildren(['walletBalance']) || newData.hasChildren(['deviceInfo']) || newData.hasChildren(['lastActive']) || newData.hasChildren(['lastLogin']) || newData.hasChildren(['uid'])"
      }
    },

    "wallets": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true || (auth.uid === $userId && (!data.exists() || (newData.child('balance').val() <= data.child('balance').val() + 100 && newData.child('balance').val() >= 0))))",
        ".validate": "newData.hasChildren(['balance']) && newData.child('balance').isNumber() && newData.child('balance').val() >= 0"
      }
    },

    "withdraw_requests": {
      ".read": "auth != null",
      ".indexOn": ["userId", "status", "date"],
      "$requestId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'Pending') || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['userId', 'coins', 'rupees']) || newData.hasChildren(['status'])"
      }
    },

    "chats": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        "messages": {
          "$msgId": {
            ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])"
          }
        },
        "metadata": {
          ".validate": "newData.hasChildren(['lastMessage', 'lastTimestamp']) || newData.hasChildren(['unreadByAdmin']) || newData.hasChildren(['unreadByUser'])"
        }
      }
    },

    "marqueeMessages": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      "$lang": {
        "$messageId": {
          ".validate": "newData.hasChildren(['text', 'active'])"
        }
      }
    },

    "marqueeConfig": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)"
    },

    "quizConfig": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
      ".validate": "newData.hasChildren(['rewardPoints', 'penaltyPoints']) && newData.child('rewardPoints').isNumber() && newData.child('penaltyPoints').isNumber()"
    }
  }
}
