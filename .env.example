# ==========================================
# CoinVault Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit your real .env file to git!
# ==========================================

CLIPDROP_API_KEY=YOUR_CLIPDROP_API_KEY_HERE

# AdMob Ad Unit IDs
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_REWARDED_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_APP_OPEN_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_TOP_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_BOTTOM_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# App Information
APP_NAME=CoinVault
VERSION_NAME=1.8
VERSION_CODE=3
PACKAGE_NAME=com.facevaultapp

# UI Themes
BG_COLOR_1=#0617
BG_COLOR_2=#0f17

# Android Release Signing (Use environment secrets in CI/CD)
RELEASE_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
RELEASE_KEY_ALIAS=YOUR_KEY_ALIAS
RELEASE_KEY_PASSWORD=YOUR_KEY_PASSWORD
